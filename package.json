{
  "name": "@boldblackai/create-dispatch",
  "version": "1.1.1",
  "description": "CLI to generate dispatch agent repositories",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-dispatch": "dist/cli.js"
  },
  "packageManager": "pnpm@11.9.0",
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "lint": "pnpm lint:ts && pnpm lint:md",
    "lint:ts": "oxlint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "tsc && node --test"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "js-yaml": "4.1.0",
    "markdownlint-cli2": "0.17.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "create",
    "scaffold",
    "hermes",
    "harness",
    "ecs",
    "slack",
    "aws"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldblackai/create-dispatch.git"
  },
  "homepage": "https://dispatch.boldblack.ai"
}
